<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.app" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!-- Launch theme of MainActivity: the splash screen (androidx core-splashscreen, installSplashScreen()
         in MainActivity), replaced by Theme.app once the activity starts. -->
    <style name="Theme.app.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.app</item>
    </style>
</resources>
